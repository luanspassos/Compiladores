type intArray = array [10] of integer

function bSort(a: intArray, n: integer): intArray
{
    var i, j, v: integer;
    i = 0;
    while (i < n)
    {
        var d1: integer;
        j = i + 1;
        while (j < n)
        {
            var d2: integer;
            if (a[i] > a[j])
            {
                var d3: integer;
                v = a[i];
                a[i] = a[j];
                a[j] = v;
            }
            j = j + 1;
        }
        i = i + 1;
    }
    return a;
}

function soma(a: intArray): integer
{
    var i, s: integer;
    i = 0;
    s = 0;
    while (i < 10)
        s = s + a[i++];
    return s;
}
